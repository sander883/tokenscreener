# Telegram bot token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Chat ID tujuan notifikasi (bisa group/channel/personal)
# Cara dapetin: chat ke bot lo, lalu buka https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Interval polling (detik). Default 60.
POLL_INTERVAL=60

# ─── GMGN Configuration ────────────────────────────────────────────────────
# Aktifin enrichment dari GMGN (default: true)
ENABLE_GMGN=true

# GMGN API Key (WAJIB kalau ENABLE_GMGN=true)
# Daftar di https://gmgn.ai/ai untuk dapatkan API key
# Langkah:
#   1. Generate Ed25519 key pair
#   2. Upload public key di https://gmgn.ai/ai
#   3. Copy API key yang muncul, taro di sini
GMGN_API_KEY=your_gmgn_api_key_here

# Chain untuk GMGN query (default: sol)
# Options: sol, bsc, base, eth
GMGN_CHAIN=sol

# Max concurrent requests ke GMGN (default: 5)
GMGN_CONCURRENCY=5

# Debug mode — simpan raw response dari GMGN (default: off)
# GMGN_DEBUG=1
